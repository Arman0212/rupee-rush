{
  "name": "rupee-rush",
  "version": "0.1.0",
  "description": "Multiplayer property-trading board game set in Indian cities",
  "main": "server/index.js",
  "private": true,
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "validate": "node scripts/validate-board.js",
    "test": "node --test",
    "simulate": "node scripts/simulate.js",
    "smoke": "node scripts/smoke.js",
    "ui-check": "node scripts/ui-check.js",
    "images": "node scripts/make-images.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.3.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "playwright": "^1.64.0",
    "socket.io-client": "^4.8.4"
  }
}
